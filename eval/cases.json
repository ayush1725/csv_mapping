{
  "_comment": "Labelled eval set for policy_v2. `expect` is the canonical field the resolver should produce; null means abstention is the correct answer and any confident mapping is a FAILURE. Replace/extend with real partner headers from the manual-resolution history — that is what makes the numbers trustworthy.",
  "schema_id": "policy_v2",
  "cases": [

    { "group": "trivial", "header": "Member Number", "expect": "Member Number" },
    { "group": "trivial", "header": "Branch Code", "expect": "Branch Code" },
    { "group": "trivial", "header": "Occupation", "expect": "Occupation" },
    { "group": "trivial", "header": "PEP", "expect": "PEP" },

    { "group": "abbreviation", "header": "Loan Account Number", "expect": "Loan A/c No" },
    { "group": "abbreviation", "header": "Cust A/c No", "expect": "Customer A/c No" },
    { "group": "abbreviation", "header": "Mobile Number", "expect": "Mobile No" },
    { "group": "abbreviation", "header": "No of Lives", "expect": "No. of Lives" },
    { "group": "abbreviation", "header": "Annual Income", "expect": "Annual_Income" },

    { "group": "typo", "header": "Applicatn Date", "expect": "Application Date" },
    { "group": "typo", "header": "Brnch Name", "expect": "Branch Name" },
    { "group": "typo", "header": "Nominee Naem", "expect": "Nominee First Name" },
    { "group": "typo", "header": "Sum Insurred", "expect": "Sum Insured" },

    { "group": "synonym", "header": "Sum Assured", "expect": "Sum Insured" },
    { "group": "synonym", "header": "Loan Sanctioned Amount", "expect": "Loan Amount" },
    { "group": "synonym", "header": "Beneficiary First Name", "expect": "Nominee First Name" },
    { "group": "synonym", "header": "Beneficiary Relationship", "expect": "Nominee Relation" },
    { "group": "synonym", "header": "Date of Disbursement", "expect": "Loan Disbursal Date" },
    { "group": "synonym", "header": "Policy Term", "expect": "Tenure" },

    { "group": "opaque_with_values", "header": "col_17",
      "samples": ["2020-01-15", "2019-11-03", "2021-06-22"],
      "expect": "Transaction Date",
      "note": "Only resolvable from values + position; several date fields compete." },
    { "group": "opaque_with_values", "header": "field_9",
      "samples": ["rahul.k@example.com", "s.mehta@example.in"],
      "expect": "Email Id" },
    { "group": "opaque_with_values", "header": "c22",
      "samples": ["9876543210", "9123456789", "9988776655"],
      "expect": "Mobile No" },

    { "group": "no_textual_overlap", "header": "Premium Amt",
      "samples": ["1250.00", "980.50", "3400.75"],
      "expect": "Amount",
      "note": "Zero string similarity with 'Amount'; the case that broke candidate shortlisting." },
    { "group": "no_textual_overlap", "header": "Hazardous Job",
      "samples": ["N", "Y", "N", "N"],
      "expect": "Does your job require handling Hazardous Material or working at significant heights or high voltage or adventure sports, merchant navy & armed forces." },
    { "group": "no_textual_overlap", "header": "Risk Category",
      "expect": "Occupation_Class" },

    { "group": "entity_explicit", "header": "Nominee DOB", "expect": "Nominee DOB" },
    { "group": "entity_explicit", "header": "Guardian Date of Birth", "expect": "Guardian DOB" },
    { "group": "entity_explicit", "header": "Insured First Name", "expect": "First Name_Plan" },
    { "group": "entity_explicit", "header": "Member DOB", "expect": "DOB_Plan" },

    { "group": "must_abstain", "header": "First Name", "expect": null,
      "note": "No sibling in the file proves which person this is. Confidently mapping it is the systematic bias." },
    { "group": "must_abstain", "header": "DOB", "expect": null,
      "note": "Four DOB fields exist; nothing here disambiguates." },
    { "group": "must_abstain", "header": "Name", "expect": null,
      "note": "First or last? Whose? Underdetermined twice over." },
    { "group": "must_abstain", "header": "Amount", "samples": ["1250.00", "3400.00"], "expect": null,
      "note": "Competes with Loan Amount, Sum Insured, Add On SumInsured, Annual_Income." },
    { "group": "must_abstain", "header": "Date", "samples": ["2020-01-15", "2021-06-22"], "expect": null,
      "note": "Eight date fields; a bare 'Date' picks none of them." },
    { "group": "must_abstain", "header": "xyz_42", "expect": null,
      "note": "No header signal, no values. Nothing to reason from." },
    { "group": "must_abstain", "header": "Relation", "expect": null,
      "note": "Proposer-to-insured relation, or the nominee's? Both exist." },

    { "group": "trap_wrong_person", "header": "Applicant First Name", "expect": "First Name",
      "note": "Applicant = proposer. Must NOT land on First Name_Plan or Nominee First Name." },
    { "group": "trap_wrong_person", "header": "Life Assured DOB", "expect": "DOB_Plan",
      "note": "Life assured = the insured member, not the borrower." },
    { "group": "trap_confusable", "header": "Address 2", "expect": "Address Line 2",
      "note": "Must not collapse onto Address Line 1 (they score 97 against each other)." },
    { "group": "trap_confusable", "header": "Txn Date", "expect": "Transaction Date",
      "note": "Must not land on Transaction Id (94.8 similarity)." },
    { "group": "trap_confusable", "header": "Payment Ref No", "expect": "Payment Reference Number",
      "note": "Must not land on Payment Frequency (86.1 similarity)." }
  ]
}
